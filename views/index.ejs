<!DOCTYPE html>
<html lang="en">
<head>
<title>Safar.pk — Discover Pakistan</title>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/navbar') %>

<section class="hero">
  <div class="wrap">
    <h1>Discover Pakistan, one place at a time.</h1>
    <p class="sub">Browse famous mountains, historical sites, and lakes across Pakistan, book tours and hotel stays, and read reviews from other travelers.</p>
    <form class="search-form" method="GET" action="/">
      <input type="text" name="q" placeholder="Search places (e.g. Hunza, mosque, lake)" value="<%= filters.q %>">
      <select name="province">
        <option value="">All provinces</option>
        <% provinces.forEach(p => { %>
          <option value="<%= p %>" <%= filters.province === p ? 'selected' : '' %>><%= p %></option>
        <% }) %>
      </select>
      <select name="category">
        <option value="">All categories</option>
        <% categories.forEach(c => { %>
          <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn btn-primary">Search</button>
    </form>
  </div>
</section>

<section class="grid-section">
  <div class="wrap">
    <p class="results-meta"><%= places.length %> place<%= places.length === 1 ? '' : 's' %> found</p>

    <% if (places.length === 0) { %>
      <div class="empty-state">
        <p>No places match your search. Try clearing a filter, or <a href="/places/suggest" style="color:var(--teal); text-decoration:underline;">suggest a new place</a>.</p>
      </div>
    <% } else { %>
      <div class="place-grid">
        <% places.forEach(place => { %>
          <a class="place-card" href="/places/<%= place.id %>">
            <img src="<%= place.photo || 'https://picsum.photos/seed/placeholder/600/400' %>" alt="<%= place.name %>">
            <div class="place-card-body">
              <div class="place-card-tags">
                <span class="tag"><%= place.province %></span>
                <span class="tag"><%= place.category %></span>
              </div>
              <h3><%= place.name %></h3>
              <div class="place-card-meta">
                <span>
                  <% if (place.avg_rating) { %>
                    <span class="stars">★ <%= place.avg_rating %></span> (<%= place.review_count %>)
                  <% } else { %>
                    No reviews yet
                  <% } %>
                </span>
                <span><%= place.estimated_cost ? place.estimated_cost.split(' ')[0] + ' ' + place.estimated_cost.split(' ')[1] : '' %></span>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
