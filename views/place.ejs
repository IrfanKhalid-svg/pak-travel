<!DOCTYPE html>
<html lang="en">
<head>
<title><%= place.name %> — Safar.pk</title>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/navbar') %>

<section class="place-hero">
  <div class="wrap">
    <div class="place-card-tags">
      <span class="tag"><%= place.province %></span>
      <span class="tag"><%= place.category %></span>
    </div>
    <h1><%= place.name %></h1>
    <p>
      <% if (avg_rating) { %>
        <span class="stars">★ <%= avg_rating %></span> · <%= review_count %> review<%= review_count === 1 ? '' : 's' %>
      <% } else { %>
        <span style="color:var(--ink-soft)">No reviews yet — be the first</span>
      <% } %>
    </p>

    <% if (photos.length > 0) { %>
      <div class="photo-gallery">
        <img src="<%= photos[0].url %>" alt="<%= place.name %>">
        <% if (photos.length > 1) { %>
          <div class="side-photos">
            <% photos.slice(1, 3).forEach(p => { %>
              <img src="<%= p.url %>" alt="<%= place.name %>">
            <% }) %>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</section>

<div class="wrap detail-layout">
  <div>
    <div class="detail-block">
      <h2>About</h2>
      <p><%= place.description || 'No description yet.' %></p>
    </div>

    <div class="fact-grid">
      <div class="fact">
        <div class="fact-label">Best time to visit</div>
        <div class="fact-value"><%= place.best_time || '—' %></div>
      </div>
      <div class="fact">
        <div class="fact-label">Entry fee</div>
        <div class="fact-value"><%= place.entry_fee || '—' %></div>
      </div>
      <div class="fact">
        <div class="fact-label">How to get there</div>
        <div class="fact-value"><%= place.how_to_get_there || '—' %></div>
      </div>
      <div class="fact">
        <div class="fact-label">Estimated trip cost</div>
        <div class="fact-value"><%= place.estimated_cost || '—' %></div>
      </div>
    </div>

    <% if (place.map_lat && place.map_lng) { %>
      <div class="detail-block">
        <h2>Location</h2>
        <div class="map-embed">
          <iframe
            src="https://www.openstreetmap.org/export/embed.html?bbox=<%= place.map_lng - 0.05 %>%2C<%= place.map_lat - 0.05 %>%2C<%= place.map_lng + 0.05 %>%2C<%= place.map_lat + 0.05 %>&layer=mapnik&marker=<%= place.map_lat %>%2C<%= place.map_lng %>"
            loading="lazy">
          </iframe>
        </div>
      </div>
    <% } %>

    <div class="detail-block" id="reviews">
      <h2>Reviews (<%= review_count %>)</h2>

      <% if (reviews.length === 0) { %>
        <p style="color:var(--ink-soft);">No reviews yet.</p>
      <% } %>
      <% reviews.forEach(r => { %>
        <div class="review">
          <div class="review-top">
            <span class="review-name"><%= r.user_name %></span>
            <span class="review-date"><%= r.created_at.split(' ')[0] %></span>
          </div>
          <div class="stars">
            <%= '★'.repeat(r.rating) + '☆'.repeat(5 - r.rating) %>
          </div>
          <% if (r.comment) { %><p><%= r.comment %></p><% } %>
          <% if (r.photos.length > 0) { %>
            <div class="review-photos">
              <% r.photos.forEach(p => { %>
                <img src="<%= p.url %>" alt="review photo">
              <% }) %>
            </div>
          <% } %>
        </div>
      <% }) %>

      <% if (user) { %>
        <form class="review-form" action="/places/<%= place.id %>/reviews" method="POST" enctype="multipart/form-data">
          <h3>Leave a review</h3>
          <div class="rating-select">
            <% for (let i = 5; i >= 1; i--) { %>
              <input type="radio" id="star<%= i %>" name="rating" value="<%= i %>" <%= i === 5 ? 'checked' : '' %>>
              <label for="star<%= i %>">★</label>
            <% } %>
          </div>
          <textarea name="comment" placeholder="Share your experience..."></textarea>
          <div style="margin-top:12px;">
            <label style="font-size:13px; color:var(--ink-soft); display:block; margin-bottom:6px;">Add photos (optional)</label>
            <input type="file" name="photos" accept="image/*" multiple>
          </div>
          <button type="submit" class="btn btn-primary" style="margin-top:14px;">Submit review</button>
        </form>
      <% } else { %>
        <p class="form-note"><a href="/login" style="color:var(--teal); text-decoration:underline;">Log in</a> to leave a review.</p>
      <% } %>
    </div>
  </div>

  <div>
    <% if (tours.length > 0) { %>
      <div class="side-card">
        <h3>Guided tours</h3>
        <% tours.forEach(t => { %>
          <div class="list-item">
            <div class="list-item-top">
              <span class="list-item-name"><%= t.name %></span>
              <span class="list-item-price">PKR <%= t.price.toLocaleString() %></span>
            </div>
            <div class="list-item-desc"><%= t.duration %> — <%= t.description %></div>
          </div>
        <% }) %>

        <% if (user) { %>
          <form class="booking-form" action="/places/<%= place.id %>/book" method="POST">
            <input type="hidden" name="type" value="tour">
            <div>
              <label>Choose tour</label>
              <select name="reference_id" required>
                <% tours.forEach(t => { %>
                  <option value="<%= t.id %>"><%= t.name %> — PKR <%= t.price.toLocaleString() %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <label>Start date</label>
              <input type="date" name="date_from" required>
            </div>
            <div>
              <label>Guests</label>
              <input type="number" name="guests" min="1" value="1">
            </div>
            <button type="submit" class="btn btn-primary btn-full">Request booking</button>
          </form>
        <% } else { %>
          <p class="form-note"><a href="/login" style="color:var(--teal); text-decoration:underline;">Log in</a> to book a tour.</p>
        <% } %>
      </div>
    <% } %>

    <% if (hotels.length > 0) { %>
      <div class="side-card">
        <h3>Nearby hotels</h3>
        <% hotels.forEach(h => { %>
          <div class="list-item">
            <div class="list-item-top">
              <span class="list-item-name"><%= h.name %></span>
              <span class="list-item-price">PKR <%= h.price_per_night.toLocaleString() %>/night</span>
            </div>
            <div class="list-item-desc"><%= h.description %></div>
            <% if (h.contact) { %><div class="list-item-desc">Contact: <%= h.contact %></div><% } %>
          </div>
        <% }) %>

        <% if (user) { %>
          <form class="booking-form" action="/places/<%= place.id %>/book" method="POST">
            <input type="hidden" name="type" value="hotel">
            <div>
              <label>Choose hotel</label>
              <select name="reference_id" required>
                <% hotels.forEach(h => { %>
                  <option value="<%= h.id %>"><%= h.name %> — PKR <%= h.price_per_night.toLocaleString() %>/night</option>
                <% }) %>
              </select>
            </div>
            <div>
              <label>Check-in</label>
              <input type="date" name="date_from" required>
            </div>
            <div>
              <label>Check-out</label>
              <input type="date" name="date_to">
            </div>
            <div>
              <label>Guests</label>
              <input type="number" name="guests" min="1" value="1">
            </div>
            <button type="submit" class="btn btn-primary btn-full">Request booking</button>
          </form>
        <% } else { %>
          <p class="form-note"><a href="/login" style="color:var(--teal); text-decoration:underline;">Log in</a> to book a hotel.</p>
        <% } %>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
</body>
</html>
